# =====================================================================
#  Copie este archivo como .env y complete los valores:
#      cp .env.example .env
#  La aplicación lee .env automáticamente al iniciar.
#  .env contiene SECRETOS: nunca lo suba a Git (ya está en .gitignore).
# =====================================================================

# ---------- Servidor ----------
# 127.0.0.1 = solo accesible desde este computador (recomendado para pruebas).
# Use :8080 para aceptar conexiones de otros equipos de la red.
APP_ADDR=127.0.0.1:8080

# ---------- GitHub ----------
# api  = consulta GitHub real (requiere token)
# demo = datos ficticios para probar sin token
GITHUB_MODE=api

# Token de SOLO LECTURA (ver GUIA_MAC.md, paso 4)
#  - Proyectos de su cuenta personal o de VARIAS organizaciones: token CLÁSICO (ghp_...) con scopes
#    read:project y read:org (+ repo si hay repos privados)
#  - Proyectos de una organización:   token FINE-GRAINED (github_pat_...) con "Projects: Read-only"
GITHUB_TOKEN=

# ¿De qué organizaciones se muestran los proyectos?
#  auto     = TODAS las organizaciones a las que pertenece la cuenta dueña del token
#             (token clásico con read:org). Se detectan solas: si la cuenta entra a
#             una organización nueva, sus proyectos aparecen sin tocar nada.
#  org|user = solo los dueños listados en GITHUB_OWNER.
GITHUB_OWNER_TYPE=auto
# Organizaciones o usuarios, separados por coma (lo que aparece en la URL:
# github.com/orgs/ESTE/projects/1  o  github.com/users/ESTE/projects/1).
# Con auto es opcional: sirve para AGREGAR dueños extra, p. ej. su usuario personal.
GITHUB_OWNER=

# Tiempo que se reutiliza la información antes de volver a consultar GitHub
CACHE_TTL=2m

# Nombres de los campos del proyecto en GitHub (alias separados por coma).
# "go run ./cmd/server check" le muestra los nombres reales de sus campos.
FIELD_STATUS=Status,Estado
FIELD_PRIORITY=Priority,Prioridad
FIELD_ESTIMATE=Estimate,Estimación,Size
FIELD_START_DATE=Start date,Fecha de inicio
FIELD_DUE_DATE=Target date,Due date,End date,Fecha de entrega
# Valores de "Status" que significan tarea terminada
DONE_STATUSES=Done,Hecho,Terminado,Completado

# ---------- Base de datos ----------
# mongo = MongoDB real | memory = en memoria (se borra al reiniciar, solo pruebas)
STORE=mongo
# MongoDB instalado con Homebrew en su Mac (sin usuario/contraseña, solo escucha en localhost)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gh_projects_viewer

# ---------- Seguridad ----------
# false SOLO para pruebas en http://localhost. En producción con HTTPS: true
COOKIE_SECURE=false
# true SOLO si hay un proxy inverso de confianza (Nginx/Caddy) delante de la app
TRUST_PROXY_HEADERS=false
SESSION_IDLE_TIMEOUT=30m
SESSION_MAX_LIFETIME=8h

# Primer administrador: se crea solo si la base de datos NO tiene usuarios.
# Deberá cambiar la contraseña en el primer ingreso. Mínimo 12 caracteres con letras y números.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=CambiarEsta2026

# ---------- Solo para docker compose (opcional) ----------
# Dónde se publica la app: 127.0.0.1:8080 = solo este servidor (con proxy HTTPS delante)
#                          8080           = cualquier equipo de la red, puerto 8080
APP_PUBLISH=127.0.0.1:8080
# Con docker compose, STORE y MONGO_URI se ignoran: se usa el Mongo del contenedor.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambie-esta-clave-root-larga
MONGO_APP_USER=gpv_app
MONGO_APP_PASSWORD=cambie-esta-clave-app-larga
